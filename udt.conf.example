# ---- upside-down-ternet configuration -------------------------------------
# Generated by ./wizard.sh -- edit by hand only if you know what you are doing.

# Wireless interface and radio
UDT_IFACE=wlan0
UDT_SSID=upside-down-ternet
UDT_CHANNEL=6
UDT_HW_MODE=g                 # g = 2.4GHz, a = 5GHz
UDT_COUNTRY=US

# Open network (captive portal is the gate). Set a passphrase to also require WPA2.
UDT_PASSPHRASE=

# Portal network
UDT_NET=10.83.0.0/24
UDT_GW=10.83.0.1
UDT_DHCP_START=10.83.0.50
UDT_DHCP_END=10.83.0.200
UDT_UPLINK=vmbr0              # interface that reaches the internet

# Bandwidth tiers, applied per client in both directions.
# Everyone starts as a guest; promote with: udtctl trust <mac|email>
UDT_RATE=128kbit            # guest  -- enough to play with the joke, nothing more
UDT_RATE_STANDARD=5mbit     # standard
UDT_RATE_TRUSTED=100mbit    # trusted -- effectively uncapped

# Flip images 180 degrees on cleartext HTTP (the original joke). 0 disables.
UDT_FLIP=1

# Retention for the consent/activity database, in days. 0 = keep forever.
UDT_RETENTION_DAYS=30

# Upstream DNS for portal clients
UDT_DNS1=1.1.1.1
UDT_DNS2=8.8.8.8

# ---- deployment mode ------------------------------------------------------
# public : open network, captive portal is the only gate (the demo/teaching AP)
# lab    : WPA2 required + hostapd MAC allowlist. Nothing can even associate
#          unless you have added its MAC with `udtctl allow <mac>`.
UDT_MODE=public

# Optionally shrink the cell so it does not spill past your walls.
# Value is in mBm: 800 = 8 dBm. Blank = card maximum.
UDT_TXPOWER=

# ---- optional TLS interception (mitmproxy) --------------------------------
# OFF by default. When enabled, a device is intercepted ONLY if both hold:
#   1. you turned it on for that device  (udtctl mitm <mac> on)
#   2. that device actually trusts the CA, proven by a live TLS handshake
# Any device failing either test is spliced through untouched. There is no
# way to intercept a device that has not installed the CA -- that is the point.
UDT_MITM=0
UDT_MITM_PORT=8081
UDT_MITM_CHECK_PORT=8443
UDT_MITM_CHECK_HOST=mitm-check.udt

# Automatic sorting. With this on, the portal silently probes each arriving
# device: one that trusts the CA is promoted to the trusted tier (full speed,
# traffic decrypted) with no clicks, and one that does not stays a throttled,
# image-flipped guest and sees no error. This is what lets a single radio serve
# both audiences at once. Requires UDT_MITM=1.
UDT_MITM_AUTO=0
